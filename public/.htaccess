# SPA fallback for Apache — serves index.html for client-side routes.
# Replaces the old Vercel rewrite (vercel.json). Vite copies everything in
# /public into the build output, so this lands at the web root (/public_html).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Force HTTPS (apex + www already point here at DNS level)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Long-cache hashed build assets; never cache index.html so deploys take effect.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpe?g|gif|svg|webp|mp4|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
